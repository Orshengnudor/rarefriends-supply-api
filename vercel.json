{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/total-supply",
      "destination": "/api/supply?field=total-supply"
    },
    {
      "source": "/api/circulating-supply",
      "destination": "/api/supply?field=circulating-supply"
    },
    {
      "source": "/api/burned-supply",
      "destination": "/api/supply?field=burned-supply"
    },
    {
      "source": "/api/nft-supply",
      "destination": "/api/supply?field=nft-supply"
    },
    {
      "source": "/api/genesis-total-supply",
      "destination": "/api/supply?field=genesis-total-supply"
    },
    {
      "source": "/api/genesis-circulating-supply",
      "destination": "/api/supply?field=genesis-circulating-supply"
    },
    {
      "source": "/api/generations-total-supply",
      "destination": "/api/supply?field=generations-total-supply"
    },
    {
      "source": "/api/generations-circulating-supply",
      "destination": "/api/supply?field=generations-circulating-supply"
    }
  ]
}
